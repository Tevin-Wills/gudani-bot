    {"ve": "Ni khou ita hani?", "en": "How are you?", "note": "Literal: 'How are you doing?'"},
    {"ve": "Ndi khou ita zwavhuḓi", "en": "I am doing well", "note": "Common reply to 'Ni khou ita hani?'"},
    {"ve": "Madzina anu ndi mini?", "en": "What is your name?", "note": "Plural/respectful form."},
