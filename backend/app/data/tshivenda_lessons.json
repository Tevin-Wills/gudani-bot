    {"ve": "Ni nga mphusa?", "en": "Can you help me?", "note": "Polite request for help."},
    {"ve": "A thi ḓivhi", "en": "I don't know", "note": "Useful when you're not sure."},
    {"ve": "Ee / Hai", "en": "Yes / No", "note": "Very common, learn these first."}
