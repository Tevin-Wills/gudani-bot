  "lessons": [
    {
      "id": "greetings-101",
      "title": "Tshivenda Greetings 101",
      "level": "beginner",
      "summary": "Basic Tshivenda greetings, when to use them, and how to respond.",
      "content": [
        "'Ndaa' is the standard respectful greeting. Use it with elders, in formal settings, or with anyone you want to show respect to.",
        "'Aa' is the informal version, used with children or close friends. It can also be a response to 'Ndaa'.",
        "After greeting, ask: 'Ni khou ita hani?' (How are you?). The plural 'ni' is the respectful form even for one person.",
        "Reply: 'Ndi khou ita zwavhuḓi, ndi a livhuwa.' (I am well, thank you.)",
        "When parting, say 'Sala zwavhuḓi' to someone staying behind, or 'Tshimbila zwavhuḓi' to someone going away."
      ],
      "practice": [
        "Greet your friend in the morning: Ndaa! Matsheloni avhuḓi.",
        "Ask how they are: Ni khou ita hani?",
        "Reply: Ndi khou ita zwavhuḓi."
      ]
    },
    {
      "id": "introducing-yourself",
      "title": "Introducing Yourself",
      "level": "beginner",
      "summary": "Say your name and ask someone theirs.",
      "content": [
        "'Madzina anga ndi …' = 'My name is …'",
        "'Madzina anu ndi mini?' = 'What is your name?'",
        "'Ndi bva …' = 'I am from …' (then add the place)",
        "'Ndi na minwaha …' = 'I am … years old'"
      ],
      "practice": [
        "Madzina anga ndi Tevin. Madzina anu ndi mini?",
        "Ndi bva Thohoyandou.",
        "Ndi na minwaha 22."
      ]
    },
    {
      "id": "asking-for-help",
      "title": "Asking for Help",
      "level": "beginner",
      "summary": "Useful phrases to ask for and offer help.",
      "content": [
        "'Ni nga mphusa?' = 'Can you help me?'",
        "'Ndi humbela thuso' = 'I am asking for help'",
        "'Ndi nga ni thusa nga mini?' = 'How can I help you?'",
        "'Ndi a livhuwa' = 'Thank you'"
      ],
      "practice": [
        "Ni nga mphusa? Ndi xela.",
        "Ee, ndi nga ni thusa.",
        "Ndi a livhuwa."
      ]
    }
  ]
